//@version=5
strategy("SKJ Method - Smart Money Sniper (v1.0)", shorttitle="SKJ SMS v1.0", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=100, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=250, currency=currency.USD, commission_type=strategy.commission.percent, commission_value=0.1)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🔧 USER INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Risk Management
account_size = input.float(250, "Account Size ($)", minval=100, maxval=10000, group="💰 Risk Management")
risk_per_trade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, group="💰 Risk Management")
max_stop_loss_pips = input.int(10, "Max Stop Loss (Pips)", minval=5, maxval=50, group="💰 Risk Management")

// Strategy Settings
sniper_mode_only = input.bool(true, "Sniper Mode Only (All Confluences Required)", group="🎯 Strategy Settings")
demo_mode = input.bool(false, "Demo Mode (Log Skipped Trades)", group="🎯 Strategy Settings")
session_filter = input.bool(true, "Session Filter (NY Only)", group="🎯 Strategy Settings")
news_filter = input.bool(true, "News Filter (Skip High Impact)", group="🎯 Strategy Settings")

// Lookback Periods
liquidity_lookback = input.int(20, "Liquidity Lookback", minval=10, maxval=50, group="📊 Lookback Settings")
pattern_lookback = input.int(50, "Pattern Detection Lookback", minval=20, maxval=100, group="📊 Lookback Settings")
volume_lookback = input.int(20, "Volume Average Lookback", minval=10, maxval=50, group="📊 Lookback Settings")

// Visual Settings
show_individual_signals = input.bool(false, "Show Individual Components", group="🎨 Visual Settings")
show_fvg_boxes = input.bool(true, "Show FVG Boxes", group="🎨 Visual Settings")
show_patterns = input.bool(true, "Show Pattern Labels", group="🎨 Visual Settings")

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🕐 SESSION AND NEWS FILTER LOGIC
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// New York Session (13:00 to 21:00 UTC)
ny_session = time(timeframe.period, "1300-2100", "UTC")
is_ny_session = not na(ny_session)

// Simulated News Events (Major impact times - simplified for demo)
is_news_time = false
news_minutes = [0, 30, 1200, 1230, 1400, 1430] // Simplified news times
for minute in news_minutes
    if (hour * 60 + minute) >= (minute - 30) and (hour * 60 + minute) <= (minute + 30)
        is_news_time := true
        break

// Session filter check
session_ok = not session_filter or is_ny_session
news_ok = not news_filter or not is_news_time

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 📊 CORE CALCULATIONS AND INDICATORS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// ATR for dynamic levels
atr = ta.atr(14)

// Volume analysis
volume_ma = ta.sma(volume, volume_lookback)
volume_spike = volume > volume_ma * 2.0 // Iceberg detection threshold
volume_boost = volume > volume_ma * 1.2

// Price levels
recent_high = ta.highest(high, liquidity_lookback)
recent_low = ta.lowest(low, liquidity_lookback)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🔍 LIQUIDITY SWEEP DETECTION (TRAP DETECTION)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

detectTrap() =>
    // Bullish liquidity sweep: Price wicks below recent low but closes back above
    bullish_sweep = low < recent_low[1] and close > recent_low[1] and close > open
    
    // Bearish liquidity sweep: Price wicks above recent high but closes back below  
    bearish_sweep = high > recent_high[1] and close < recent_high[1] and close < open
    
    [bullish_sweep, bearish_sweep]

[bull_trap, bear_trap] = detectTrap()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🔥 ENGULFING CANDLE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

checkEngulf() =>
    // Strong bullish engulfing: Current candle body engulfs previous candle
    bull_engulf = close > open and close > high[1] and open < low[1] and (close - open) > (high[1] - low[1]) * 0.6
    
    // Strong bearish engulfing: Current candle body engulfs previous candle
    bear_engulf = close < open and close < low[1] and open > high[1] and (open - close) > (high[1] - low[1]) * 0.6
    
    [bull_engulf, bear_engulf]

[bull_engulf, bear_engulf] = checkEngulf()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎯 FAIR VALUE GAP (FVG) DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

var box[] bullish_fvg_boxes = array.new<box>()
var box[] bearish_fvg_boxes = array.new<box>()
var bool in_bullish_fvg = false
var bool in_bearish_fvg = false

drawFVG() =>
    // Bullish FVG: Gap between high[2] and low[0] with no overlap at high[1] and low[1]
    bullish_fvg = low > high[2] and low[1] > high[2]
    
    // Bearish FVG: Gap between low[2] and high[0] with no overlap at low[1] and high[1]  
    bearish_fvg = high < low[2] and high[1] < low[2]
    
    if bullish_fvg and show_fvg_boxes
        fvg_box = box.new(bar_index-2, high[2], bar_index+10, low, bgcolor=color.new(color.green, 85), border_color=color.green, border_width=1)
        array.push(bullish_fvg_boxes, fvg_box)
        label.new(bar_index, low, "FVG 🎯", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
    
    if bearish_fvg and show_fvg_boxes
        fvg_box = box.new(bar_index-2, low[2], bar_index+10, high, bgcolor=color.new(color.red, 85), border_color=color.red, border_width=1)
        array.push(bearish_fvg_boxes, fvg_box)
        label.new(bar_index, high, "FVG 🎯", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
    
    // Check if price is in FVG
    in_bull_fvg = false
    in_bear_fvg = false
    
    if array.size(bullish_fvg_boxes) > 0
        for i = 0 to array.size(bullish_fvg_boxes) - 1
            fvg_box = array.get(bullish_fvg_boxes, i)
            if not na(fvg_box)
                fvg_top = box.get_top(fvg_box)
                fvg_bottom = box.get_bottom(fvg_box)
                if close >= fvg_bottom and close <= fvg_top
                    in_bull_fvg := true
                    break
    
    if array.size(bearish_fvg_boxes) > 0
        for i = 0 to array.size(bearish_fvg_boxes) - 1
            fvg_box = array.get(bearish_fvg_boxes, i)
            if not na(fvg_box)
                fvg_top = box.get_top(fvg_box)
                fvg_bottom = box.get_bottom(fvg_box)
                if close >= fvg_bottom and close <= fvg_top
                    in_bear_fvg := true
                    break
    
    [bullish_fvg, bearish_fvg, in_bull_fvg, in_bear_fvg]

[bullish_fvg, bearish_fvg, in_bull_fvg, in_bear_fvg] = drawFVG()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ❄️ ICEBERG ORDER DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

detectIceberg() =>
    // Iceberg: High volume with small body relative to wicks
    body_size = math.abs(close - open)
    wick_size = (high - low) - body_size
    body_to_wick_ratio = body_size / wick_size
    
    iceberg_detected = volume_spike and body_to_wick_ratio < 0.3 and wick_size > atr * 0.5
    
    iceberg_detected

iceberg_order = detectIceberg()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎨 PATTERN RECOGNITION ENGINE
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

var string current_pattern = ""

detectPattern() =>
    pattern = ""
    
    // Double Top Detection
    if high == ta.highest(high, pattern_lookback) and high[5] == ta.highest(high[1], pattern_lookback-1) and math.abs(high - high[5]) < atr * 0.5
        pattern := "🔺 DOUBLE TOP"
    
    // Double Bottom Detection
    else if low == ta.lowest(low, pattern_lookback) and low[5] == ta.lowest(low[1], pattern_lookback-1) and math.abs(low - low[5]) < atr * 0.5
        pattern := "🔻 DOUBLE BOTTOM"
    
    // Head and Shoulders (simplified)
    else if high[10] < high[5] and high[5] > high and high[10] > high[15] and high > high[15]
        pattern := "👤 HEAD & SHOULDERS"
    
    // Inverse Head and Shoulders
    else if low[10] > low[5] and low[5] < low and low[10] < low[15] and low < low[15]
        pattern := "👤 INVERSE H&S"
    
    // Rising Wedge
    else if ta.rising(ta.highest(high, 10), 3) and ta.rising(ta.lowest(low, 10), 3) and ta.highest(high, 10) - ta.lowest(low, 10) < ta.highest(high, 10)[3] - ta.lowest(low, 10)[3]
        pattern := "🔺 RISING WEDGE"
    
    // Falling Wedge  
    else if ta.falling(ta.highest(high, 10), 3) and ta.falling(ta.lowest(low, 10), 3) and ta.highest(high, 10) - ta.lowest(low, 10) < ta.highest(high, 10)[3] - ta.lowest(low, 10)[3]
        pattern := "🔻 FALLING WEDGE"
    
    // Bull Flag
    else if ta.rising(close, 5) and ta.falling(close, 3) and close > ta.sma(close, 20)
        pattern := "🚩 BULL FLAG"
    
    // Bear Flag
    else if ta.falling(close, 5) and ta.rising(close, 3) and close < ta.sma(close, 20)
        pattern := "🚩 BEAR FLAG"
    
    // Wyckoff Spring
    else if low < ta.lowest(low, 20)[1] and close > ta.lowest(low, 20)[1] and volume > volume_ma * 1.5
        pattern := "📉 WYCKOFF SPRING"
    
    // Wyckoff UTAD
    else if high > ta.highest(high, 20)[1] and close < ta.highest(high, 20)[1] and volume > volume_ma * 1.5
        pattern := "📈 WYCKOFF UTAD"
    
    if pattern != "" and show_patterns
        current_pattern := pattern
        label.new(bar_index, high + atr * 0.5, pattern, style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.normal)
    
    pattern

current_pattern := detectPattern()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎯 CONFLUENCE SCORING AND SNIPER ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Calculate confluence score (0-5 points)
confluence_score = 0
if bull_trap or bear_trap
    confluence_score += 1
if bull_engulf or bear_engulf  
    confluence_score += 1
if in_bull_fvg or in_bear_fvg
    confluence_score += 1
if iceberg_order
    confluence_score += 1
if current_pattern != ""
    confluence_score += 1

// Sniper entry conditions
bullish_sniper = bull_trap and bull_engulf and in_bull_fvg and session_ok and news_ok
bearish_sniper = bear_trap and bear_engulf and in_bear_fvg and session_ok and news_ok

// Enhanced 99% setup
bull_99_setup = bullish_sniper and iceberg_order and current_pattern != "" and confluence_score >= 4
bear_99_setup = bearish_sniper and iceberg_order and current_pattern != "" and confluence_score >= 4

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 💰 RISK MANAGEMENT AND POSITION SIZING
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

calculateTP_SL(entry_price, is_long) =>
    pip_value = syminfo.mintick * 10 // Approximate pip value
    
    // Stop Loss
    sl_distance = is_long ? entry_price - (recent_low - atr * 0.5) : (recent_high + atr * 0.5) - entry_price
    sl_pips = sl_distance / pip_value
    
    // Cap at max stop loss
    if sl_pips > max_stop_loss_pips
        sl_distance := max_stop_loss_pips * pip_value
        sl_pips := max_stop_loss_pips
    
    sl_price = is_long ? entry_price - sl_distance : entry_price + sl_distance
    
    // Take Profits (1R, 2R, 3R)
    tp1_price = is_long ? entry_price + sl_distance : entry_price - sl_distance
    tp2_price = is_long ? entry_price + sl_distance * 2 : entry_price - sl_distance * 2  
    tp3_price = is_long ? entry_price + sl_distance * 3 : entry_price - sl_distance * 3
    
    // Position Size Calculation
    risk_amount = account_size * (risk_per_trade / 100)
    position_size = risk_amount / sl_distance
    
    [sl_price, tp1_price, tp2_price, tp3_price, position_size, sl_pips]

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎨 VISUAL SIGNALS AND LABELS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Show individual components (optional)
if show_individual_signals
    plotshape(bull_trap, title="Bull Trap", location=location.belowbar, color=color.orange, style=shape.circle, size=size.small)
    plotshape(bear_trap, title="Bear Trap", location=location.abovebar, color=color.orange, style=shape.circle, size=size.small)
    plotshape(bull_engulf, title="Bull Engulf", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
    plotshape(bear_engulf, title="Bear Engulf", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// Trap labels
if bull_trap
    label.new(bar_index, low, "🪤 TRAP SET", style=label.style_label_up, color=color.orange, textcolor=color.white, size=size.normal)

if bear_trap
    label.new(bar_index, high, "🪤 TRAP SET", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.normal)

// Engulfing labels
if bull_engulf
    label.new(bar_index, low * 0.9995, "🔺 ENGULF 🔥", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

if bear_engulf
    label.new(bar_index, high * 1.0005, "🔺 ENGULF 🔥", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

// Iceberg labels
if iceberg_order
    label.new(bar_index, high + atr * 0.2, "❄️ ICEBERG", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.normal)

// 99% Setup labels
if bull_99_setup
    label.new(bar_index, low * 0.999, "🚨 99% SETUP | Drop that Lot 📦💰", style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.large)

if bear_99_setup
    label.new(bar_index, high * 1.001, "🚨 99% SETUP | Drop that Lot 📦💰", style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.large)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎯 STRATEGY EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

var float entry_price = na
var float sl_price = na
var float tp1_price = na
var float tp2_price = na
var float tp3_price = na
var bool tp1_hit = false
var bool tp2_hit = false
var bool tp3_hit = false

// Entry Logic
if bullish_sniper and (not sniper_mode_only or confluence_score >= 3)
    entry_price := close
    [sl, tp1, tp2, tp3, pos_size, sl_pips] = calculateTP_SL(entry_price, true)
    sl_price := sl
    tp1_price := tp1
    tp2_price := tp2
    tp3_price := tp3
    
    strategy.entry("Long", strategy.long, qty=pos_size)
    strategy.exit("SL", "Long", stop=sl_price)
    
    // Entry label
    label.new(bar_index, low, "🟢 BUY ENTRY\nSL: " + str.tostring(sl_pips, "#.#") + " pips", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
    
    // Draw levels
    line.new(bar_index, tp1_price, bar_index + 20, tp1_price, color=color.green, style=line.style_solid, width=2)
    line.new(bar_index, tp2_price, bar_index + 20, tp2_price, color=color.green, style=line.style_solid, width=2)
    line.new(bar_index, tp3_price, bar_index + 20, tp3_price, color=color.green, style=line.style_solid, width=2)
    line.new(bar_index, sl_price, bar_index + 20, sl_price, color=color.red, style=line.style_dashed, width=2)
    
    // Reset TP flags
    tp1_hit := false
    tp2_hit := false
    tp3_hit := false

if bearish_sniper and (not sniper_mode_only or confluence_score >= 3)
    entry_price := close
    [sl, tp1, tp2, tp3, pos_size, sl_pips] = calculateTP_SL(entry_price, false)
    sl_price := sl
    tp1_price := tp1
    tp2_price := tp2
    tp3_price := tp3
    
    strategy.entry("Short", strategy.short, qty=pos_size)
    strategy.exit("SL", "Short", stop=sl_price)
    
    // Entry label
    label.new(bar_index, high, "🔴 SELL ENTRY\nSL: " + str.tostring(sl_pips, "#.#") + " pips", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
    
    // Draw levels
    line.new(bar_index, tp1_price, bar_index + 20, tp1_price, color=color.red, style=line.style_solid, width=2)
    line.new(bar_index, tp2_price, bar_index + 20, tp2_price, color=color.red, style=line.style_solid, width=2)
    line.new(bar_index, tp3_price, bar_index + 20, tp3_price, color=color.red, style=line.style_solid, width=2)
    line.new(bar_index, sl_price, bar_index + 20, sl_price, color=color.red, style=line.style_dashed, width=2)
    
    // Reset TP flags
    tp1_hit := false
    tp2_hit := false
    tp3_hit := false

// Take Profit Management
if strategy.position_size > 0 and not na(tp1_price) and not tp1_hit and high >= tp1_price
    strategy.close("Long", qty_percent=50)
    label.new(bar_index, high, "TP1 💸", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
    tp1_hit := true

if strategy.position_size > 0 and not na(tp2_price) and not tp2_hit and high >= tp2_price
    strategy.close("Long", qty_percent=30)
    label.new(bar_index, high, "TP2 💰", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
    tp2_hit := true

if strategy.position_size > 0 and not na(tp3_price) and not tp3_hit and high >= tp3_price
    strategy.close("Long", qty_percent=20)
    label.new(bar_index, high, "TP3 🧱", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
    tp3_hit := true

if strategy.position_size < 0 and not na(tp1_price) and not tp1_hit and low <= tp1_price
    strategy.close("Short", qty_percent=50)
    label.new(bar_index, low, "TP1 💸", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    tp1_hit := true

if strategy.position_size < 0 and not na(tp2_price) and not tp2_hit and low <= tp2_price
    strategy.close("Short", qty_percent=30)
    label.new(bar_index, low, "TP2 💰", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    tp2_hit := true

if strategy.position_size < 0 and not na(tp3_price) and not tp3_hit and low <= tp3_price
    strategy.close("Short", qty_percent=20)
    label.new(bar_index, low, "TP3 🧱", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    tp3_hit := true

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 📊 REAL-TIME HUD PANEL
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

drawHUD() =>
    var table hud_table = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 85), border_width=1, border_color=color.white)
    
    if barstate.islast
        // Header
        table.cell(hud_table, 0, 0, "🎯 SKJ SMART MONEY SNIPER", text_color=color.white, bgcolor=color.new(color.blue, 60), text_size=size.normal)
        table.cell(hud_table, 1, 0, "STATUS", text_color=color.white, bgcolor=color.new(color.blue, 60), text_size=size.normal)
        
        // Bull Trap
        table.cell(hud_table, 0, 1, "Bull Trap", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 1, bull_trap ? "YES" : "NO", text_color=bull_trap ? color.green : color.gray, text_size=size.small)
        
        // Bear Trap
        table.cell(hud_table, 0, 2, "Bear Trap", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 2, bear_trap ? "YES" : "NO", text_color=bear_trap ? color.red : color.gray, text_size=size.small)
        
        // Volume Boost
        table.cell(hud_table, 0, 3, "Volume Boost", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 3, volume_boost ? "YES" : "NO", text_color=volume_boost ? color.yellow : color.gray, text_size=size.small)
        
        // Pattern
        table.cell(hud_table, 0, 4, "Pattern", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 4, current_pattern != "" ? current_pattern : "None", text_color=current_pattern != "" ? color.purple : color.gray, text_size=size.small)
        
        // Sniper Mode
        table.cell(hud_table, 0, 5, "Sniper Mode", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 5, (bullish_sniper or bearish_sniper) ? "ON" : "OFF", text_color=(bullish_sniper or bearish_sniper) ? color.lime : color.gray, text_size=size.small)
        
        // Confluence Score
        table.cell(hud_table, 0, 6, "Confluence Score", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 6, str.tostring(confluence_score) + "/5", text_color=confluence_score >= 3 ? color.lime : confluence_score >= 2 ? color.yellow : color.gray, text_size=size.small)
        
        // Session Status
        table.cell(hud_table, 0, 7, "NY Session", text_color=color.white, text_size=size.small)
        table.cell(hud_table, 1, 7, is_ny_session ? "ACTIVE" : "CLOSED", text_color=is_ny_session ? color.lime : color.gray, text_size=size.small)

drawHUD()

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🚫 DEMO MODE - TRADE SKIP LOGGING
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

if demo_mode
    // Log reasons for skipped trades
    if (bull_trap or bear_trap) and not (bullish_sniper or bearish_sniper)
        skip_reason = ""
        if not (in_bull_fvg or in_bear_fvg)
            skip_reason += "🚫 Skipped: No FVG present"
        else if not session_ok
            skip_reason += "🚫 Skipped: Outside NY session"
        else if not news_ok
            skip_reason += "🚫 Skipped: News event active"
        else if not (bull_engulf or bear_engulf)
            skip_reason += "🚫 Skipped: No engulfing candle"
        else if sniper_mode_only and confluence_score < 3
            skip_reason += "🚫 Skipped: Insufficient confluence"
        
        if skip_reason != ""
            label.new(bar_index, high + atr, skip_reason, style=label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🚨 ALERT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Entry Alerts
if bullish_sniper
    alert_message = '{"Trade ID": ' + str.tostring(bar_index) + ', "Type": "BUY", "Entry": ' + str.tostring(close, "#.#####") + ', "SL": ' + str.tostring(sl_price, "#.#####") + ', "TP1": ' + str.tostring(tp1_price, "#.#####") + ', "TP2": ' + str.tostring(tp2_price, "#.#####") + ', "TP3": ' + str.tostring(tp3_price, "#.#####") + ', "Pattern": "' + current_pattern + '", "Session": "NY Session", "News Filter": "' + (news_ok ? "None" : "Active") + '", "Confluence Score": ' + str.tostring(confluence_score) + '}'
    alert("🟢 SKJ BUY ENTRY: " + syminfo.ticker + " | " + alert_message, alert.freq_once_per_bar)

if bearish_sniper
    alert_message = '{"Trade ID": ' + str.tostring(bar_index) + ', "Type": "SELL", "Entry": ' + str.tostring(close, "#.#####") + ', "SL": ' + str.tostring(sl_price, "#.#####") + ', "TP1": ' + str.tostring(tp1_price, "#.#####") + ', "TP2": ' + str.tostring(tp2_price, "#.#####") + ', "TP3": ' + str.tostring(tp3_price, "#.#####") + ', "Pattern": "' + current_pattern + '", "Session": "NY Session", "News Filter": "' + (news_ok ? "None" : "Active") + '", "Confluence Score": ' + str.tostring(confluence_score) + '}'
    alert("🔴 SKJ SELL ENTRY: " + syminfo.ticker + " | " + alert_message, alert.freq_once_per_bar)

// 99% Setup Alerts
if bull_99_setup
    alert("🚨 99% BULL SETUP: " + syminfo.ticker + " | Drop that Lot! 📦💰", alert.freq_once_per_bar)

if bear_99_setup
    alert("🚨 99% BEAR SETUP: " + syminfo.ticker + " | Drop that Lot! 📦💰", alert.freq_once_per_bar)

// TP/SL Alerts
if tp1_hit
    alert("TP1 HIT 💸: " + syminfo.ticker + " | 50% Position Closed", alert.freq_once_per_bar)

if tp2_hit
    alert("TP2 HIT 💰: " + syminfo.ticker + " | 30% Position Closed", alert.freq_once_per_bar)

if tp3_hit
    alert("TP3 HIT 🧱: " + syminfo.ticker + " | 20% Position Closed", alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 🎨 SESSION VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Shade off-hours
bgcolor(not is_ny_session ? color.new(color.gray, 95) : na, title="Off Hours")

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// 📝 STRATEGY FOOTER
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Performance metrics plotted for reference
plot(ta.sma(close, 20), title="SMA 20", color=color.new(color.white, 70), linewidth=1)
plot(ta.sma(close, 50), title="SMA 50", color=color.new(color.yellow, 70), linewidth=1)