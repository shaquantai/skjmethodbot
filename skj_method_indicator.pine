//@version=5
indicator("SKJ Method - WORKING SIGNALS", shorttitle="SKJ", overlay=true, max_boxes_count=50, max_lines_count=50, max_labels_count=50)

// Simplified Settings
liquidity_lookback = input.int(20, "Liquidity Lookback")
show_individual_signals = input.bool(false, "Show Individual Components")

// Core calculations
atr = ta.atr(14)
volume_ma = ta.sma(volume, 20)
volume_spike = volume > volume_ma * 1.2

// Simple liquidity sweeps
recent_high = ta.highest(high, liquidity_lookback)
recent_low = ta.lowest(low, liquidity_lookback)

bullish_sweep = low < recent_low[1] and close > recent_low[1]
bearish_sweep = high > recent_high[1] and close < recent_high[1]

// Simple engulfing
bull_engulf = close > open and close > high[1] and low < low[1]
bear_engulf = close < open and close < low[1] and high > high[1]

// WORKING TRAP SIGNALS (Much simpler logic)
bullish_trap = bullish_sweep and bull_engulf
bearish_trap = bearish_sweep and bear_engulf

// Enhanced signals with volume
enhanced_bull_trap = bullish_trap and volume_spike
enhanced_bear_trap = bearish_trap and volume_spike

// Show individual components (optional)
plotshape(show_individual_signals and bullish_sweep, title="Bull Sweep", location=location.belowbar, color=color.blue, style=shape.circle, size=size.tiny)
plotshape(show_individual_signals and bearish_sweep, title="Bear Sweep", location=location.abovebar, color=color.blue, style=shape.circle, size=size.tiny)
plotshape(show_individual_signals and bull_engulf, title="Bull Engulf", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.tiny)
plotshape(show_individual_signals and bear_engulf, title="Bear Engulf", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.tiny)

// MAIN TRADE SIGNALS - YOU'LL ACTUALLY SEE THESE!
if bullish_trap
    label.new(bar_index, low, text="BUY\nTRAP", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
    line.new(bar_index, close, bar_index + 10, close, color=color.blue, style=line.style_solid, width=2)
    line.new(bar_index, low - atr, bar_index + 10, low - atr, color=color.red, style=line.style_dashed, width=1)

if bearish_trap
    label.new(bar_index, high, text="SELL\nTRAP", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
    line.new(bar_index, close, bar_index + 10, close, color=color.blue, style=line.style_solid, width=2)
    line.new(bar_index, high + atr, bar_index + 10, high + atr, color=color.red, style=line.style_dashed, width=1)

// ENHANCED SIGNALS (with volume)
if enhanced_bull_trap
    label.new(bar_index, low * 0.999, text="🔥 BUY\nVOLUME CONFIRMED", style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.large)

if enhanced_bear_trap
    label.new(bar_index, high * 1.001, text="🔥 SELL\nVOLUME CONFIRMED", style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.large)

// Simple status table
var table status_table = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(status_table, 0, 0, "SKJ SIGNALS", text_color=color.white, bgcolor=color.blue)
    table.cell(status_table, 1, 0, "STATUS", text_color=color.white, bgcolor=color.blue)
    
    table.cell(status_table, 0, 1, "Bull Trap", text_color=color.white)
    table.cell(status_table, 1, 1, bullish_trap ? "ACTIVE" : "NO", text_color=bullish_trap ? color.green : color.white)
    
    table.cell(status_table, 0, 2, "Bear Trap", text_color=color.white)
    table.cell(status_table, 1, 2, bearish_trap ? "ACTIVE" : "NO", text_color=bearish_trap ? color.red : color.white)
    
    table.cell(status_table, 0, 3, "Volume Boost", text_color=color.white)
    table.cell(status_table, 1, 3, enhanced_bull_trap or enhanced_bear_trap ? "YES" : "NO", text_color=enhanced_bull_trap or enhanced_bear_trap ? color.yellow : color.white)

// Alerts
if bullish_trap
    alert("SKJ BUY SIGNAL - " + syminfo.ticker + " at " + str.tostring(close, "#.#####"), alert.freq_once_per_bar)

if bearish_trap
    alert("SKJ SELL SIGNAL - " + syminfo.ticker + " at " + str.tostring(close, "#.#####"), alert.freq_once_per_bar)